    html[data-theme="dark"] .hero-center .suggestion { border-bottom-color: #3d3d3d; }
    html[data-theme="dark"] .hero-center .suggestion-name { color: #f5f5f2; }
    html[data-theme="dark"] .hero-center .suggestion-sub-row { color: #bcbcb8; }
    html[data-theme="dark"] .hero-center .suggestion:hover,
    html[data-theme="dark"] .hero-center .suggestion[aria-selected="true"] { border-color: #666; background: #303030; }
    html[data-theme="dark"] #result,
    html[data-theme="dark"] #result .result-head { border-color: #555; background: #1b1b1b; }
    html[data-theme="dark"] #result .result-head { border-bottom-color: #555; }
    html[data-theme="dark"] #result .result-kicker { color: #bcbcb8; }
