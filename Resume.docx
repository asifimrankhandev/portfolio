    #result #ofacCard .detail-label { color: #555; }
    #result #ofacCard .detail-value { color: #111; }
    html[data-theme="dark"] #result #currencyCard,
    html[data-theme="dark"] #result #continentCard,
    html[data-theme="dark"] #result #ofacCard { border-color: #444; background: #1b1b1b; }
    html[data-theme="dark"] #result #continentCard.continent-africa { background: #1b1b1b; }
    html[data-theme="dark"] #result #ofacCard .detail-label { color: #d2d2ce; }
    html[data-theme="dark"] #result #ofacCard .detail-value { color: #fff; }
    @media (max-width: 900px) {
      #result .detail-grid { gap: 9px; }
      #result #currencyCard,
      #result #continentCard { border-left: 1px solid #d4d4d0; }
      #result #continentCard,
      #result #ofacCard { border-top: 1px solid #d4d4d0; }
      html[data-theme="dark"] #result #currencyCard,
      html[data-theme="dark"] #result #continentCard,
      html[data-theme="dark"] #result #ofacCard { border-color: #444; }
    }
    @media (max-width: 560px) {
      #result .detail-grid { gap: 8px; margin: 0 10px 10px; }
      #result #countryCodeCard,
      #result #currencyCard,
      #result #continentCard,
      #result #ofacCard { min-height: 112px; padding: 12px; }
    }
    /* Repeat the lead card's small corner marker across the neutral cards. */
    #result #currencyCard,
    #result #continentCard,
    #result #ofacCard { position: relative; }
    #result #currencyCard::after,
    #result #continentCard::after,
    #result #ofacCard::after {
      position: absolute;
      top: 17px;
      right: 17px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #333;
      content: "";
    }
    #result #continentCard.continent-africa::after,
    #result #ofacCard.ofac-cat1::after { background: #b42318; }
    #result #ofacCard.ofac-cat2::after { background: #d18037; }
    #result #ofacCard.ofac-clear::after { background: #39704e; }
    @media (max-width: 560px) {
      #result #currencyCard::after,
      #result #continentCard::after,
      #result #ofacCard::after { top: 12px; right: 12px; }
    }
    /* Unified palette: warm editorial neutrals, with color reserved for status. */
    #result #currencyCard {
      border-color: #deddd5;
      background: #f1f0eb;
    }
    #result #continentCard {
      border-color: #d7ddd6;
      background: #e9eee9;
    }
    #result #continentCard.continent-africa {
      border-color: #dfc0bc;
      background: #f5e8e5;
    }
    #result #ofacCard {
      border-color: #171717;
      background: #171717;
    }
    #result #ofacCard .detail-label { color: #d2d2ce; }
    #result #ofacCard .detail-value { color: #fff; }
    html[data-theme="dark"] #result #currencyCard { border-color: #46443d; background: #24231f; }
    html[data-theme="dark"] #result #continentCard { border-color: #3d4a40; background: #202722; }
    html[data-theme="dark"] #result #continentCard.continent-africa { border-color: #633632; background: #2c1e1d; }
  </style>
</head>
<body>
  <div class="shell">
    <!-- Top Navigation Header -->
    <header class="topline" role="banner">
      <div class="topline-brand">
        <div class="brandmark" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.46z"/></svg>
        </div>
        <div class="brand-meta">
          <div class="brand-title-row">
            <span class="brand-name">CountryScope</span>
          </div>
        </div>
      </div>
 
      <div class="topline-actions">
        <!-- Light / Dark Theme Toggle Button -->
        <button type="button" class="theme-toggle-btn" id="themeToggleBtn" aria-label="Switch to dark mode" title="Switch to dark mode">
          <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"></path></svg>
        </button>
      </div>
    </header>
 
    <!-- Main Content Area -->
    <main class="main-body">
      <!-- Country verification hero -->
      <section class="hero-center" aria-label="Country verification hero">
        <div class="hero-copy">
          <div class="hero-eyebrow"><span class="hero-eyebrow-dot"></span> COUNTRY INTELLIGENCE</div>
          <h1 class="hero-title">Country code and sanctions lookup</h1>
          <p class="hero-desc">Look up ISO country codes and currencies, check African Union membership, and review OFAC sanctions classifications.</p>
          <div class="search-area">
            <div class="search-wrap">
              <div class="search-icon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>
              <input id="countrySearch" class="search-box" type="text" placeholder="Search a country, code, or currency" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="suggestions">
              <button type="button" id="clearSearch" class="search-clear-btn" aria-label="Clear search input" title="Clear search (Esc)" style="display:none;">✕</button>
              <div class="search-kbd-hint" id="searchKbdHint"><kbd>/</kbd></div>
              <div class="search-chevron" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </div>
              <button type="button" id="focusSearch" aria-label="Focus search input" style="display:none;"></button>
              <div id="suggestions" class="suggestions" role="listbox" aria-label="Country suggestions"></div>
            </div>
            <div id="empty" class="empty" role="status">No matching jurisdiction found in directory. Check spelling or try an ISO 3166 code.</div>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="visual-slice slice-left">
            <span class="slice-caption">GLOBAL<br>REACH</span>
            <div class="slice-map"></div>
            <span class="slice-footnote">ISO 3166-1<br>COUNTRY CODES</span>
          </div>
          <div class="visual-slice slice-center">
            <span class="slice-caption">THE WORLD<br>IN ONE SEARCH</span>
            <strong class="slice-number">249</strong>
            <span class="slice-unit">JURISDICTIONS</span>
            <div class="slice-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            <span class="slice-footnote">VERIFIED REFERENCE DATA</span>
          </div>
          <div class="visual-slice slice-right">
            <span class="slice-caption">TRUSTED<br>SOURCES</span>
            <div class="slice-stamp">✓</div>
            <span class="slice-source">ISO<br><b>OFAC</b><br>AU</span>
            <span class="slice-footnote">BUILT FOR<br>CONFIDENCE</span>
          </div>
        </div>

      </section>

      <!-- Verified Profile Deck (Only revealed when a user selects a jurisdiction) -->
      <section id="result" class="result" aria-live="polite">
        <div class="result-head">
          <div>
            <div class="result-kicker">VERIFIED JURISDICTION PROFILE</div>
            <h2 id="countryName">—</h2>
          </div>
          <div class="result-actions">
            <div class="iso-chip" id="isoChip">ISO 3166-1</div>
            <button type="button" class="result-close-btn" id="closeResultBtn">
              ✕ Clear
            </button>
          </div>
        </div>
 
        <div class="detail-grid">
          <article class="detail" id="countryCodeCard">
            <div class="detail-label">Country Code</div>
            <div class="detail-value" id="countryCode">—</div>
          </article>
 
          <article class="detail" id="currencyCard">
            <div class="detail-label">Currency Code</div>
            <div class="detail-value"><span id="currencyCode">—</span><span class="detail-value-note" id="currencyName"></span></div>
          </article>
 
          <article class="detail" id="continentCard">
            <div class="detail-label">Continent</div>
            <div class="detail-value" id="continent">—</div>
          </article>
 
          <article class="detail" id="ofacCard">
            <div class="detail-label">OFAC Compliance Classification</div>
            <div class="detail-value">
              <span class="category-pill" id="ofacCategory">—</span>
            </div>
          </article>
        </div>
 
      </section>

      <!-- Reference directories remain available before and after a search. -->
      <nav class="references" aria-label="Country and sanctions reference lists">
        <span class="references-intro">
          <span class="references-label">REFERENCE LIBRARY</span>
          <strong>Official country lists</strong>
          <small>Open a source directory</small>
        </span>
        <a class="reference-link" href="https://ofac.treasury.gov/sanctions-programs-and-country-information" target="_blank" rel="noopener noreferrer" title="Official OFAC Category 1 sanctions country list">
          <span aria-hidden="true">↗</span> OFAC1 Sanction country list
        </a>
        <a class="reference-link" href="https://ofac.treasury.gov/sanctions-programs-and-country-information" target="_blank" rel="noopener noreferrer" title="Official OFAC Category 2 sanctions country list">
          <span aria-hidden="true">↗</span> OFAC2 Sanction country list
        </a>
        <a class="reference-link" href="https://au.int/en/member_states" target="_blank" rel="noopener noreferrer" title="African Union member country list">
          <span aria-hidden="true">↗</span> African Country list
        </a>
      </nav>
 

    </main>

    <details class="directory-overview-drawer" id="directoryOverviewDrawer">
      <summary class="directory-overview-tab" aria-label="Toggle directory overview">
        <span class="directory-tab-mark" aria-hidden="true">▦</span>
        <span class="directory-tab-label">Directory Overview</span>
      </summary>
      <div class="directory-overview-panel">
        <section class="telemetry-section" id="liveStatusContainer" aria-label="Directory overview details" aria-live="polite">
          <div class="telemetry-header-bar">
            <span class="panel-kicker" id="liveStatusTitle">At a glance</span>
          </div>
          <div class="telemetry-grid">
            <div class="status-chip chip-card-green" id="chipOne">
              <div class="chip-top"><span class="chip-number" id="chipOneVal">249</span></div>
              <div class="chip-content"><h3 class="chip-label" id="chipOneLabel">Total Countries</h3><p class="chip-sub" id="chipOneSub">ISO 3166-1 Directory</p></div>
            </div>
            <div class="status-chip chip-card-red" id="chipTwo">
              <div class="chip-top"><span class="chip-number" id="chipTwoVal">58</span></div>
              <div class="chip-content"><h3 class="chip-label" id="chipTwoLabel">African Nations</h3><p class="chip-sub" id="chipTwoSub">55 AU Member States</p></div>
            </div>
            <div class="status-chip chip-card-red" id="chipThree">
              <div class="chip-top"><span class="chip-number" id="chipThreeVal">06</span></div>
              <div class="chip-content"><h3 class="chip-label" id="chipThreeLabel">OFAC Category 1</h3><p class="chip-sub" id="chipThreeSub">3 States · 3 Regions</p></div>
            </div>
            <div class="status-chip chip-card-orange" id="chipFour">
              <div class="chip-top"><span class="chip-number" id="chipFourVal">35</span></div>
              <div class="chip-content"><h3 class="chip-label" id="chipFourLabel">OFAC Category 2</h3><p class="chip-sub" id="chipFourSub">Targeted Programs</p></div>
            </div>
          </div>
        </section>
      </div>
    </details>

    <!-- Site Footer -->
    <footer class="site-footer" role="contentinfo">
      <span id="coverage" style="display: none;" aria-hidden="true"></span>
      <span class="footer-credit">Designed by AIK with <span class="bow-symbol" aria-label="love">ᯓᡣ𐭩</span></span>
    </footer>
  </div>
 
  <script>
    'use strict';
const COUNTRIES_BY_CONTINENT = { "Africa": [{ "name": "Algeria", "aliases": ["Algeria", "DZ", "Dzayer", "Algérie"], "iso2": "DZ", "iso3": "DZA", "numericCode": "012", "currencies": ["DZD"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "DZ", "currency": "DZD", "ofac1": false, "ofac2": false }, { "name": "Angola", "aliases": ["Angola", "AO", "República de Angola", "ʁɛpublika de an'ɡɔla"], "iso2": "AO", "iso3": "AGO", "numericCode": "024", "currencies": ["AOA"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "AO", "currency": "AOA", "ofac1": false, "ofac2": false }, { "name": "Benin", "aliases": ["Benin", "BJ", "Republic of Benin", "République du Bénin"], "iso2": "BJ", "iso3": "BEN", "numericCode": "204", "currencies": ["XOF"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "BJ", "currency": "XOF", "ofac1": false, "ofac2": false }, { "name": "Botswana", "aliases": ["Botswana", "BW", "Republic of Botswana", "Lefatshe la Botswana"], "iso2": "BW", "iso3": "BWA", "numericCode": "072", "currencies": ["BWP"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "BW", "currency": "BWP", "ofac1": false, "ofac2": false }, { "name": "Burkina Faso", "aliases": ["Burkina Faso", "BF"], "iso2": "BF", "iso3": "BFA", "numericCode": "854", "currencies": ["XOF"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "BF", "currency": "XOF", "ofac1": false, "ofac2": false }, { "name": "Burundi", "aliases": ["Burundi", "BI", "Republic of Burundi", "Republika y'Uburundi", "République du Burundi"], "iso2": "BI", "iso3": "BDI", "numericCode": "108", "currencies": ["BIF"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "BI", "currency": "BIF", "ofac1": false, "ofac2": false }, { "name": "Cabo Verde", "aliases": ["Cabo Verde"], "iso2": "CV", "iso3": "CPV", "numericCode": "132", "currencies": ["CVE"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "CV", "currency": "CVE", "ofac1": false, "ofac2": false }, { "name": "Cameroon", "aliases": ["Cameroon", "CM", "Republic of Cameroon", "République du Cameroun"], "iso2": "CM", "iso3": "CMR", "numericCode": "120", "currencies": ["XAF"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "CM", "currency": "XAF", "ofac1": false, "ofac2": false }, { "name": "Central African Republic", "aliases": ["Central African Republic", "CF", "République centrafricaine"], "iso2": "CF", "iso3": "CAF", "numericCode": "140", "currencies": ["XAF"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "CF", "currency": "XAF", "ofac1": false, "ofac2": false }, { "name": "Chad", "aliases": ["Chad", "TD", "Tchad", "Republic of Chad", "République du Tchad"], "iso2": "TD", "iso3": "TCD", "numericCode": "148", "currencies": ["XAF"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "TD", "currency": "XAF", "ofac1": false, "ofac2": false }, { "name": "Comoros", "aliases": ["Comoros", "KM", "Union of the Comoros", "Union des Comores", "Udzima wa Komori", "al-Ittiḥād al-Qumurī"], "iso2": "KM", "iso3": "COM", "numericCode": "174", "currencies": ["KMF"], "continent": "Africa", "isAfricanContinent": true, "isAfricanUnionMember": true, "ofacCategory": "Not assessed", "code": "KM", "currency": "KMF", "ofac1": false, "ofac2": false }, { "name": "Congo", "aliases": ["Congo", "CG", "Congo-Brazzaville"], "iso2": "CG", "iso3": "COG", "numericCode": "