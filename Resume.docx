      #result #countryCodeCard .detail-value,
      #result #countryCodeCard:not(.code-alert) .detail-value,
      #result #countryCodeCard.code-alert .detail-value { font-size: 38px; }
      #result #currencyCode { font-size: 32px; }
      #result #ofacCard .category-pill { font-size: 15px; }
    }
    /* Remove generic card framing from the two neutral data columns. */
    #result .detail-grid { gap: 0; margin: 10px 16px 14px; }
    #result .detail,
    #result .detail:nth-child(2),
    #result .detail:nth-child(3),
    #result .detail:last-child {
      min-height: 132px;
