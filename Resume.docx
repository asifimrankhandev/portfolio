    html[data-theme="dark"] #ofacCard.ofac-cat2 { border-top-color: #e69b60; }
    .directory-overview-panel .telemetry-section { padding: 14px; }
    body.has-country-result .main-body { row-gap: 14px; }
    body.has-country-result .hero-center {
