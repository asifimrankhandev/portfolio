      .directory-overview-panel .telemetry-section { width: 100%; padding: 16px 12px; }
      .directory-overview-panel .status-chip { min-height: 88px; padding: 10px; }
    }
    /* A consistent, scan-friendly country profile with status color only on its data. */
    #result,
