    html[data-theme="dark"] #result #countryCodeCard:not(.code-alert) .detail-value { color: #173f2b; }
    html[data-theme="dark"] #result #countryCodeCard.code-alert .detail-value { color: #9f211b; }
    html[data-theme="dark"] #result #currencyCode { color: #f5f5f2; }
