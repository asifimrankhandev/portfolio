      #result .detail-value,
      #result #countryCodeCard .detail-value,
      #result #currencyCode,
      #result #continentCard .detail-value { font-size: 25px; }
    }
    /* Result profile follows the reference's signature yellow feature tile and hard grid. */
    #result { border: 1px solid #111; background: #fff; }
    #result .result-head { min-height: 92px; padding: 16px 20px; }
    #result .result-kicker { color: #696969; font-size: 9px; letter-spacing: .16em; }
