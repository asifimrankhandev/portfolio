    html[data-theme="dark"] :focus-visible { outline-color: #f4dc00; }
    /* Density and baseline pass, tuned to the supplied Kenya profile screenshot. */
    #result .result-head { min-height: 82px; padding-block: 11px; }
    #result h2 { font-size: clamp(27px,3vw,36px); }
    #result .detail-grid { gap: 9px; margin: 10px 14px 14px; }
