    ];
    const COUNTRIES = Object.values(COUNTRIES_BY_CONTINENT).flat();
    const SEARCHABLE_LOCATIONS = [...COUNTRIES, ...OFAC_1_SANCTION_REGIONS];
    // Fail fast on malformed embedded reference data rather than silently returning misleading results.
    (function validateEmbeddedData() {
      const seenIso2 = new Set();
      const seenIso3 = new Set();
      for (const [group, entries] of Object.entries(COUNTRIES_BY_CONTINENT)) {
        for (const country of entries) {
          if (country.continent !== group) throw new Error(`Continent group mismatch: ${country.name}`);
          if (!/^[A-Z]{2}$/.test(country.iso2) || !/^[A-Z]{3}$/.test(country.iso3) || !/^\d{3}$/.test(country.numericCode)) throw new Error(`Invalid ISO code format: ${country.name}`);
          if (country.code !== country.iso2) throw new Error(`Country code mismatch: ${country.name}`);
          if (seenIso2.has(country.iso2) || seenIso3.has(country.iso3)) throw new Error(`Duplicate ISO code: ${country.name}`);
          seenIso2.add(country.iso2); seenIso3.add(country.iso3);
          if (!Array.isArray(country.currencies) || country.currencies.some(code => !/^[A-Z]{3}$/.test(code))) throw new Error(`Invalid currency code format: ${country.name}`);
          if (country.isAfricanContinent !== (country.continent === 'Africa')) throw new Error(`African geography flag mismatch: ${country.name}`);
        }
      }
      for (const entry of OFAC_2_SANCTION_COUNTRIES) {
        if (!/^[A-Z]{3}$/.test(entry.iso3)) throw new Error(`Invalid Category 2 code: ${entry.name}`);
        if (!COUNTRIES.some(country => country.iso3 === entry.iso3)) throw new Error(`Category 2 entry not mapped to country data: ${entry.name}`);
      }
      for (const region of OFAC_1_SANCTION_REGIONS) {
        if (region.type !== 'region' || !region.parentCountry || !region.code) throw new Error(`Invalid Category 1 region entry: ${region.name}`);
      }
    })();
    const input = document.getElementById('countrySearch');
    const suggestions = document.getElementById('suggestions');
    const result = document.getElementById('result');
    const directoryOverviewDrawer = document.getElementById('directoryOverviewDrawer');
    const empty = document.getElementById('empty');
    if (directoryOverviewDrawer) {
      directoryOverviewDrawer.addEventListener('pointerenter', event => {
        if (event.pointerType === 'mouse') directoryOverviewDrawer.open = true;
      });
      directoryOverviewDrawer.addEventListener('pointerleave', event => {
        if (event.pointerType === 'mouse' && !directoryOverviewDrawer.contains(document.activeElement)) {
          directoryOverviewDrawer.open = false;
        }
      });
    }
    let activeIndex = -1;
    let currentMatches = [];
    const normalize = value => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().trim();
    // Currency lookup dictionary for major world currencies
    const CURRENCY_INFO = {
      "USD": "US Dollar ($)", "EUR": "Euro (€)", "GBP": "British Pound (£)", "JPY": "Japanese Yen (¥)",
      "CHF": "Swiss Franc", "CAD": "Canadian Dollar ($)", "AUD": "Australian Dollar ($)", "NZD": "New Zealand Dollar ($)",
      "CNY": "Chinese Yuan (¥)", "INR": "Indian Rupee (₹)", "BRL": "Brazilian Real (R$)", "RUB": "Russian Ruble (₽)",
      "KRW": "South Korean Won (₩)", "SGD": "Singapore Dollar ($)", "HKD": "Hong Kong Dollar ($)", "SEK": "Swedish Krona",
      "NOK": "Norwegian Krone", "DKK": "Danish Krone", "PLN": "Polish Zloty (zł)", "TRY": "Turkish Lira (₺)",
      "ZAR": "South African Rand (R)", "MXN": "Mexican Peso ($)", "SAR": "Saudi Riyal (﷼)", "AED": "UAE Dirham (د.إ)",
      "NGN": "Nigerian Naira (₦)", "EGP": "Egyptian Pound (E£)", "KES": "Kenyan Shilling", "GHS": "Ghanaian Cedi (₵)",
      "MAD": "Moroccan Dirham", "XOF": "West African CFA Franc", "XAF": "Central African CFA Franc",
      "DZD": "Algerian Dinar", "AOA": "Angolan Kwanza", "BWP": "Botswana Pula", "BIF": "Burundian Franc",
      "CVE": "Cape Verdean Escudo", "KMF": "Comorian Franc", "CDF": "Congolese Franc", "DJF": "Djiboutian Franc",
      "ERN": "Eritrean Nakfa", "SZL": "Swazi Lilangeni", "ETB": "Ethiopian Birr", "GMD": "Gambian Dalasi",
      "GNF": "Guinean Franc", "LSL": "Lesotho Loti", "LRD": "Liberian Dollar ($)", "LYD": "Libyan Dinar",
      "MGA": "Malagasy Ariary", "MWK": "Malawian Kwacha", "MRU": "Mauritanian Ouguiya", "MUR": "Mauritian Rupee",
      "MZN": "Mozambican Metical", "NAD": "Namibian Dollar ($)", "RWF": "Rwandan Franc", "STN": "São Tomé Dobra",
      "SCR": "Seychellois Rupee", "SLE": "Sierra Leonean Leone", "SOS": "Somali Shilling", "SSP": "South Sudanese Pound",
