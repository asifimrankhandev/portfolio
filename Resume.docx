      #result .result-head { padding-inline: 14px; }
    }
    /* Dark theme contrast pass: preserve yellow/red/green signals, lift neutral text. */
    html[data-theme="light"] { color-scheme: light; }
    html[data-theme="dark"] {
      color-scheme: dark;
      --bg-base: #111;
      --bg-card: #1b1b1b;
      --bg-card-hover: #282828;
      --text-title: #f7f7f5;
      --text-main: #e9e9e7;
      --text-muted: #bcbcb8;
      --text-dim: #a3a39e;
      --border-subtle: #3e3e3e;
      --border-medium: #5a5a5a;
    }
    html[data-theme="dark"] body { background: #202020; color: #e9e9e7; }
    html[data-theme="dark"] .shell { background: #151515; }
    html[data-theme="dark"] .topline { border-bottom-color: #505050; }
    html[data-theme="dark"] .hero-center { border-color: #505050; background: #1b1b1b; }
