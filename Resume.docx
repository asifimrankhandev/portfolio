      "ZMW": "Zambian Kwacha", "ZWG": "Zimbabwe Gold"
    };
 
    function formatCurrency(currencies) {
      if (!currencies || !currencies.length) return 'Not available';
      return currencies.map(c => {
        const info = CURRENCY_INFO[c];
        return info ? `${c} — ${info}` : `${c} (ISO 4217)`;
      }).join(' · ');
    }
 
    function matchesFor(query) {
      const q = normalize(query);
      if (!q) return [];
 
      const isOfac1Query = ['ofac 1', 'ofac1', 'cat 1', 'cat1', 'category 1'].includes(q);
      const isOfac2Query = ['ofac 2', 'ofac2', 'cat 2', 'cat2', 'category 2'].includes(q);
      const isSanctionsQuery = ['ofac', 'sanction', 'sanctions', 'embargo', 'watchlist'].includes(q);
      const isAfricaQuery = ['africa', 'african', 'african union', 'au'].includes(q);
 
      const categoryEntries = [...OFAC_1_SANCTION_COUNTRIES, ...OFAC_2_SANCTION_COUNTRIES];
 
      return SEARCHABLE_LOCATIONS.map(country => {
        let score = 0;
        let matchContext = '';
 
        const nameNorm = normalize(country.name);
        const iso2Norm = normalize(country.iso2);
        const iso3Norm = normalize(country.iso3);
        const numNorm = normalize(country.numericCode);
        const codeNorm = normalize(country.code);
 
        const isSpecialRegion = country.type === 'region';
        const isOfac1 = isSpecialRegion || OFAC_1_SANCTION_COUNTRIES.some(e => e.iso3 === country.iso3 || normalize(e.name) === nameNorm);
        const isOfac2 = !isOfac1 && OFAC_2_SANCTION_COUNTRIES.some(e => e.iso3 === country.iso3 || normalize(e.name) === nameNorm);
 
        const complianceAliases = categoryEntries
          .filter(entry => entry.iso3 && entry.iso3 === country.iso3)
          .flatMap(entry => [entry.name, ...(entry.aliases || [])]);
        const allAliases = Array.from(new Set([...(country.aliases || []), ...complianceAliases]));
 
        // 1. Categorical Intent Matches
        if (isOfac1Query && isOfac1) {
          score = isSpecialRegion ? 880 : 900;
          matchContext = 'OFAC Category 1 Regime';
        } else if (isOfac2Query && isOfac2) {
          score = 900;
          matchContext = 'OFAC Category 2 Regime';
        } else if (isSanctionsQuery && (isOfac1 || isOfac2)) {
          score = isOfac1 ? 920 : 850;
          matchContext = isOfac1 ? 'OFAC Cat 1 Embargo' : 'OFAC Cat 2 Targeted';
        } else if (isAfricaQuery && country.isAfricanContinent) {
          score = country.isAfricanUnionMember ? 900 : 750;
          matchContext = country.isAfricanUnionMember ? 'African Union Member' : 'African Continent';
        }
 
        // 2. Exact Direct Identifier Matches (Highest Priority)
        if (nameNorm === q) {
          score = Math.max(score, 1000);
          matchContext = 'Exact Jurisdiction Name';
        } else if (iso2Norm === q) {
          score = Math.max(score, 980);
          matchContext = 'ISO Alpha-2 Match';
        } else if (iso3Norm === q) {
          score = Math.max(score, 970);
          matchContext = 'ISO Alpha-3 Match';
        } else if (codeNorm === q) {
          score = Math.max(score, isSpecialRegion ? 950 : 960);
          matchContext = isSpecialRegion ? 'Regional Code: ' + country.code : 'ISO Alpha-3 Match';
        } else if (numNorm === q) {
          score = Math.max(score, 940);
          matchContext = 'ISO Numeric: ' + country.numericCode;
        } else if (allAliases.some(a => normalize(a) === q)) {
          score = Math.max(score, 920);
          const matchedAlias = allAliases.find(a => normalize(a) === q);
          matchContext = 'AKA: ' + matchedAlias;
        }
 
        // 3. Name or Code Prefix Matches
        else if (nameNorm.startsWith(q)) {
          score = Math.max(score, 820 + Math.max(0, 30 - nameNorm.length));
          matchContext = 'Name Prefix';
        } else if (nameNorm.split(/[\s,.-]+/).some(word => word.startsWith(q))) {
          score = Math.max(score, 780);
          matchContext = 'Word in Name';
        } else if (iso3Norm.startsWith(q) || codeNorm.startsWith(q)) {
          score = Math.max(score, 720);
          matchContext = 'Code Prefix: ' + (country.iso3 || country.code);
        } else if (allAliases.some(a => normalize(a).startsWith(q))) {
          score = Math.max(score, 680);
          const matchedAlias = allAliases.find(a => normalize(a).startsWith(q));
          matchContext = 'AKA: ' + matchedAlias;
        }
 
        // 4. Currency Matches
        else if ((country.currencies || []).some(c => normalize(c) === q)) {
          score = Math.max(score, 600);
          matchContext = 'Official Currency: ' + country.currencies.join(', ');
        } else if (q.length >= 3 && (country.currencies || []).some(c => normalize(c).startsWith(q))) {
          score = Math.max(score, 480);
          matchContext = 'Currency Prefix';
        }
 
        // 5. Substring Contains (Gated to q.length >= 3 to prevent noise on 2-letter codes)
        else if (q.length >= 3 && nameNorm.includes(q)) {
          score = Math.max(score, 400);
          matchContext = 'Name Contains';
        } else if (q.length >= 3 && allAliases.some(a => normalize(a).includes(q))) {
          score = Math.max(score, 350);
          const matchedAlias = allAliases.find(a => normalize(a).includes(q));
          matchContext = 'AKA: ' + matchedAlias;
        }
 
        return Object.assign({}, country, { _score: score, _matchContext: matchContext });
      })
      .filter(item => item._score > 0)
      .sort((a, b) => b._score - a._score || a.name.localeCompare(b.name))
      .slice(0, 8);
    }
 
    function makeSuggestion(country, index) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'suggestion';
      button.role = 'option';
      button.id = `suggestion-${index}`;
      button.setAttribute('aria-selected', String(index === activeIndex));
 
      const content = document.createElement('div');
      content.className = 'suggestion-content';
 
      // Title Row
      const titleRow = document.createElement('div');
      titleRow.className = 'suggestion-title-row';
 
      const icon = document.createElement('span');
      icon.className = 'suggestion-type-icon';
      icon.textContent = country.type === 'region' ? '📍' : '🌐';
      titleRow.appendChild(icon);
 
      const name = document.createElement('span');
      name.className = 'suggestion-name';
      name.textContent = country.name;
      titleRow.appendChild(name);
 
      if (country._matchContext && country._matchContext !== 'Exact Jurisdiction Name') {
        const matchBadge = document.createElement('span');
        matchBadge.className = 'suggestion-match-badge';
        matchBadge.textContent = country._matchContext;
        titleRow.appendChild(matchBadge);
      }
      content.appendChild(titleRow);
 
      // Subtitle Row with Codes, Currency & Continent
      const subRow = document.createElement('div');
      subRow.className = 'suggestion-sub-row';
 
      const codeParts = [];
      if (country.type === 'region') {
        if (country.code) codeParts.push(`Code: ${country.code}`);
        if (country.parentCountry) codeParts.push(`Parent: ${country.parentCountry}`);
      } else {
        if (country.iso2) codeParts.push(`Alpha-2: ${country.iso2}`);
        if (country.iso3) codeParts.push(`Alpha-3: ${country.iso3}`);
        if (country.numericCode) codeParts.push(`Num: ${country.numericCode}`);
        if (country.currencies && country.currencies.length) {
          codeParts.push(`Cur: ${country.currencies.join('/')}`);
        }
      }
      if (country.continent) {
        codeParts.push(country.continent);
      }
 
      codeParts.forEach((part, pIdx) => {
        if (pIdx > 0) {
          const dot = document.createElement('span');
          dot.className = 'suggestion-divider';
          dot.textContent = '·';
          subRow.appendChild(dot);
        }
        const span = document.createElement('span');
        span.className = 'suggestion-meta-item';
        span.textContent = part;
        subRow.appendChild(span);
      });
      content.appendChild(subRow);
 
      // Status Badges on the right
      const badgesWrap = document.createElement('div');
      badgesWrap.className = 'suggestion-badges';
 
      const isSpecialRegion = country.type === 'region';
      const isOfac1 = isSpecialRegion || OFAC_1_SANCTION_COUNTRIES.some(e => e.iso3 === country.iso3 || normalize(e.name) === normalize(country.name));
      const isOfac2 = !isOfac1 && OFAC_2_SANCTION_COUNTRIES.some(e => e.iso3 === country.iso3 || normalize(e.name) === normalize(country.name));
 
      if (isOfac1) {
        const b = document.createElement('span');
        b.className = 'suggestion-pill pill-alert';
        b.textContent = 'OFAC · CAT 1';
        b.title = 'Listed in the OFAC Category 1 data';
        badgesWrap.appendChild(b);
      } else if (isOfac2) {
        const b = document.createElement('span');
        b.className = 'suggestion-pill pill-amber';
        b.textContent = 'OFAC · CAT 2';
        b.title = 'Listed in the OFAC Category 2 data';
        badgesWrap.appendChild(b);
      } else {
        const b = document.createElement('span');
        b.className = 'suggestion-pill pill-clear';
        b.textContent = 'NOT LISTED';
        b.title = 'No match in the OFAC lists included in this registry';
        badgesWrap.appendChild(b);
      }
 
      if (country.isAfricanContinent) {
        const bAfrica = document.createElement('span');
        bAfrica.className = 'suggestion-pill pill-africa';
        bAfrica.textContent = 'AFRICA';
        bAfrica.title = 'Geographically located in Africa';
        badgesWrap.appendChild(bAfrica);
      }

      if (country.isAfricanUnionMember) {
        const bAu = document.createElement('span');
        bAu.className = 'suggestion-pill pill-au';
        bAu.textContent = 'AU MEMBER';
        badgesWrap.appendChild(bAu);
      }
 
      button.append(content, badgesWrap);
      button.addEventListener('click', () => selectCountry(country));
      return button;
    }
 
    const clearSearchBtn = document.getElementById('clearSearch');
    const searchKbdHintEl = document.getElementById('searchKbdHint');
 
    function renderSuggestions() {
      currentMatches = matchesFor(input.value);
      activeIndex = -1;
      suggestions.replaceChildren();
 
      const queryVal = input.value.trim();
      if (clearSearchBtn) {
        clearSearchBtn.style.display = queryVal ? 'inline-flex' : 'none';
      }
      if (searchKbdHintEl) {
        searchKbdHintEl.style.display = queryVal ? 'none' : 'flex';
      }
 
      if (!queryVal) {
        suggestions.classList.remove('open');
        input.setAttribute('aria-expanded', 'false');
        empty.style.display = 'none';
        resetToStandby();
        return;
      }
 
      if (!currentMatches.length) {
        suggestions.classList.remove('open');
        input.setAttribute('aria-expanded', 'false');
        empty.style.display = 'block';
        return;
      }
 
      empty.style.display = 'none';
      currentMatches.forEach((country, index) => suggestions.appendChild(makeSuggestion(country, index)));
      suggestions.classList.add('open');
      input.setAttribute('aria-expanded', 'true');
    }
 
    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value || "—";
    }
 
    function selectCountry(country) {
      selectedCountryRecord = country;
      document.body.classList.add('has-country-result');
      input.value = country.name;
      if (clearSearchBtn) clearSearchBtn.style.display = 'inline-flex';
      if (searchKbdHintEl) searchKbdHintEl.style.display = 'none';
      suggestions.classList.remove('open');
      suggestions.replaceChildren();
      input.setAttribute('aria-expanded', 'false');
      empty.style.display = 'none';
 
      // 1. Title & ISO Chip
      setText('countryName', country.name);
      setText('isoChip', country.type === 'region' ? `SPECIAL REGION · ${country.parentCountry}` : 'ISO 3166-1 OFFICIAL');
 
      // 2. ISO Country Codes
      setText('countryCode', country.type === 'region' ? country.code : country.iso3);
 
      // 3. Currency Code
      const currencyCodes = country.type === 'region' ? [] : (country.currencies || []);
      setText('currencyCode', currencyCodes.join(' · ') || '—');
      setText('currencyName', currencyCodes.map(code => CURRENCY_INFO[code] || '').filter(Boolean).join(' · ') || (country.type === 'region' ? 'Not applicable to this region' : 'Currency information unavailable'));
 
      // 4. Continental Status
      setText('continent', country.continent || 'Global / Unassigned');
      let contSub = '';
      if (country.type === 'region') {
        contSub = `Regional Jurisdiction · Parent: ${country.parentCountry}`;
      } else if (country.isAfricanUnionMember) {
        contSub = '✓ Official African Union Member State (AU)';
      } else if (country.isAfricanContinent) {
        contSub = 'Geographic African Territory (Non-AU)';
      } else {
        contSub = 'Non-African Jurisdiction · Not AU Member';
      }
      setText('continentSub', contSub);
 
      const continentCard = document.getElementById('continentCard');
      if (continentCard) continentCard.classList.toggle('continent-africa', country.isAfricanContinent === true);
 
      // 5. OFAC Compliance Classification
      const matchesCountryList = list => list.some(entry =>
        entry.iso3 === country.iso3 || normalize(entry.name) === normalize(country.name) ||
        (entry.aliases || []).some(alias => normalize(alias) === normalize(country.name) || (country.aliases || []).some(a => normalize(a) === normalize(alias)))
      );
      const isSpecialRegion = country.type === 'region';
      const inOfac1 = isSpecialRegion || matchesCountryList(OFAC_1_SANCTION_COUNTRIES);
      const inOfac2 = !isSpecialRegion && matchesCountryList(OFAC_2_SANCTION_COUNTRIES);
      const countryCodeCard = document.getElementById('countryCodeCard');
      if (countryCodeCard) countryCodeCard.classList.toggle('code-alert', country.isAfricanContinent === true || inOfac1 || inOfac2);
 
      const ofacCard = document.getElementById('ofacCard');
      const ofacCategoryEl = document.getElementById('ofacCategory');
      if (ofacCard) {
        ofacCard.classList.remove('ofac-listed', 'ofac-cat1', 'ofac-cat2', 'ofac-clear');
        if (inOfac1) {
          ofacCard.classList.add('ofac-cat1');
          if (ofacCategoryEl) ofacCategoryEl.className = 'category-pill pill-alert';
          setText('ofacCategory', isSpecialRegion ? 'Category 1 · Regional' : 'Category 1 · Comprehensive');
        } else if (inOfac2) {
          ofacCard.classList.add('ofac-cat2');
          if (ofacCategoryEl) ofacCategoryEl.className = 'category-pill pill-amber';
          setText('ofacCategory', 'Category 2');
        } else {
          ofacCard.classList.add('ofac-clear');
          if (ofacCategoryEl) ofacCategoryEl.className = 'category-pill pill-clear';
          setText('ofacCategory', 'No OFAC listing');
        }
      }
 
      // Populate institutional compliance directive note
      const ofacSubEl = document.getElementById('ofacSub');
      if (ofacSubEl) {
        if (country.complianceNote) {
          ofacSubEl.textContent = country.complianceNote;
          ofacSubEl.style.display = 'block';
        } else {
          const matchedEntry = [...OFAC_1_SANCTION_COUNTRIES, ...OFAC_2_SANCTION_COUNTRIES].find(e => e.iso3 === country.iso3 || normalize(e.name) === normalize(country.name));
          if (matchedEntry && matchedEntry.complianceNote) {
            ofacSubEl.textContent = matchedEntry.complianceNote;
            ofacSubEl.style.display = 'block';
          } else if (inOfac1) {
            ofacSubEl.textContent = 'Category 1 Non-Permissible Regime. Comprehensive embargo restrictions active.';
            ofacSubEl.style.display = 'block';
          } else if (inOfac2) {
            ofacSubEl.textContent = 'Category 2 Targeted Sanctions Program. Mandatory SDN watchlist and entity screening required.';
            ofacSubEl.style.display = 'block';
          } else {
            ofacSubEl.textContent = 'Standard permissible jurisdiction. No active OFAC comprehensive or targeted regimes recorded.';
            ofacSubEl.style.display = 'block';
          }
        }
      }
 
      // Update telemetry chip inspection view
      updateLiveStatus(country);
 
      result.classList.add('visible');
    }
 
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        input.value = '';
        clearSearchBtn.style.display = 'none';
        if (searchKbdHintEl) searchKbdHintEl.style.display = 'flex';
        suggestions.classList.remove('open');
        suggestions.replaceChildren();
        empty.style.display = 'none';
        resetToStandby();
        input.focus();
      });
    }
 
    const closeResultBtn = document.getElementById('closeResultBtn');
    if (closeResultBtn) {
      closeResultBtn.addEventListener('click', () => {
        input.value = '';
        if (clearSearchBtn) clearSearchBtn.style.display = 'none';
        if (searchKbdHintEl) searchKbdHintEl.style.display = 'flex';
        suggestions.classList.remove('open');
        suggestions.replaceChildren();
        empty.style.display = 'none';
        resetToStandby();
        input.focus();
      });
    }
 
    document.getElementById('focusSearch').addEventListener('click', () => input.focus());
    input.addEventListener('input', renderSuggestions);
    input.addEventListener('keydown', event => {
      if (!suggestions.classList.contains('open')) {
        if (event.key === 'ArrowDown' && input.value.trim()) {
          renderSuggestions();
          return;
        } else if (event.key === 'Escape' && input.value.trim()) {
          input.value = '';
          if (clearSearchBtn) clearSearchBtn.style.display = 'none';
          if (searchKbdHintEl) searchKbdHintEl.style.display = 'flex';
          resetToStandby();
          return;
        }
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        activeIndex = Math.min(activeIndex + 1, currentMatches.length - 1);
        refreshActive();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        refreshActive();
      } else if (event.key === 'Enter' && currentMatches.length) {
        event.preventDefault();
        selectCountry(currentMatches[activeIndex >= 0 ? activeIndex : 0]);
      } else if (event.key === 'Escape') {
        suggestions.classList.remove('open');
        input.setAttribute('aria-expanded', 'false');
      }
    });
 
    // Keyboard '/' shortcut to quickly focus search
    document.addEventListener('keydown', event => {
      if (event.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        event.preventDefault();
        input.focus();
        input.select();
      }
    });
 
    function refreshActive() {
      [...suggestions.children].forEach((node, index) => {
        node.setAttribute('aria-selected', String(index === activeIndex));
        if (index === activeIndex) node.scrollIntoView({ block: 'nearest' });
      });
    }
 
    document.addEventListener('click', event => {
      if (!event.target.closest('.search-wrap')) {
        suggestions.classList.remove('open');
        input.setAttribute('aria-expanded', 'false');
      }
    });
 
    const covEl = document.getElementById('coverage');
    if (covEl) covEl.textContent = `${COUNTRIES.length} ISO · ${SEARCHABLE_LOCATIONS.length} JURISDICTIONS`;
 
    // Telemetry display modes
    let liveStatusDisplayMode = 'global';
    let selectedCountryRecord = null;
 
    function renderGlobalOverview() {
      liveStatusDisplayMode = 'global';
      const liveStatusTitle = document.getElementById('liveStatusTitle');
      const toggleLabel = document.getElementById('liveStatusToggleLabel');
      if (liveStatusTitle) liveStatusTitle.textContent = 'Directory Overview';
      if (toggleLabel) toggleLabel.textContent = selectedCountryRecord ? 'Query Data' : 'Overview';
 
      // Chip 1: Total Countries Available (249 ISO records)
      const chipOne = document.getElementById('chipOne');
      const chipOneVal = document.getElementById('chipOneVal');
      const chipOneLabel = document.getElementById('chipOneLabel');
      const chipOneSub = document.getElementById('chipOneSub');
      if (chipOne) chipOne.className = 'status-chip chip-card-green';
      if (chipOneVal) chipOneVal.textContent = String(COUNTRIES.length);
      if (chipOneLabel) chipOneLabel.textContent = 'Total Countries';
      if (chipOneSub) chipOneSub.textContent = 'ISO 3166-1 Directory';
 
      // Chip 2: African Countries Available (58 Geographic / 55 AU Member States)
      const chipTwo = document.getElementById('chipTwo');
      const chipTwoVal = document.getElementById('chipTwoVal');
      const chipTwoLabel = document.getElementById('chipTwoLabel');
      const chipTwoSub = document.getElementById('chipTwoSub');
      const africaCount = COUNTRIES.filter(c => c.isAfricanContinent).length;
      const auCount = COUNTRIES.filter(c => c.isAfricanUnionMember).length;
      if (chipTwo) chipTwo.className = 'status-chip chip-card-red';
      if (chipTwoVal) chipTwoVal.textContent = String(africaCount);
      if (chipTwoLabel) chipTwoLabel.textContent = 'African Nations';
      if (chipTwoSub) chipTwoSub.textContent = `${auCount} AU Member States`;
 
      // Chip 3: OFAC Category 1 (3 sovereign countries + 3 special regions = 6)
      const chipThree = document.getElementById('chipThree');
      const chipThreeVal = document.getElementById('chipThreeVal');
      const chipThreeLabel = document.getElementById('chipThreeLabel');
      const chipThreeSub = document.getElementById('chipThreeSub');
      const ofac1Total = OFAC_1_SANCTION_COUNTRIES.length + OFAC_1_SANCTION_REGIONS.length;
      if (chipThree) chipThree.className = 'status-chip chip-card-red';
      if (chipThreeVal) chipThreeVal.textContent = String(ofac1Total).padStart(2, '0');
      if (chipThreeLabel) chipThreeLabel.textContent = 'OFAC Category 1';
      if (chipThreeSub) chipThreeSub.textContent = `${OFAC_1_SANCTION_COUNTRIES.length} States · ${OFAC_1_SANCTION_REGIONS.length} Regions`;
 
      // Chip 4: OFAC Category 2 (35 targeted sanction countries)
      const chipFour = document.getElementById('chipFour');
      const chipFourVal = document.getElementById('chipFourVal');
      const chipFourLabel = document.getElementById('chipFourLabel');
      const chipFourSub = document.getElementById('chipFourSub');
      const ofac2Total = OFAC_2_SANCTION_COUNTRIES.length;
      if (chipFour) chipFour.className = 'status-chip chip-card-orange';
      if (chipFourVal) chipFourVal.textContent = String(ofac2Total);
      if (chipFourLabel) chipFourLabel.textContent = 'OFAC Category 2';
      if (chipFourSub) chipFourSub.textContent = 'Targeted Programs';
    }
 
    function renderCountryInspection(country) {
      if (!country) {
        renderGlobalOverview();
        return;
      }
      liveStatusDisplayMode = 'inspection';
      const liveStatusTitle = document.getElementById('liveStatusTitle');
      const toggleLabel = document.getElementById('liveStatusToggleLabel');
      if (liveStatusTitle) liveStatusTitle.textContent = 'Inspection';
      if (toggleLabel) toggleLabel.textContent = 'Global (4)';
 
      // Chip 1: Selected ISO Code
      const chipOne = document.getElementById('chipOne');
      const chipOneVal = document.getElementById('chipOneVal');
      const chipOneLabel = document.getElementById('chipOneLabel');
      const chipOneSub = document.getElementById('chipOneSub');
      if (chipOne) chipOne.className = 'status-chip chip-card-blue';
      if (chipOneVal) chipOneVal.textContent = country.type === 'region' ? (country.code || 'REG') : (country.iso3 || country.iso2 || 'ISO');
      if (chipOneLabel) chipOneLabel.textContent = country.type === 'region' ? 'Regional Entity' : 'ISO Alpha-3';
      if (chipOneSub) chipOneSub.textContent = country.name;
 
      // Chip 2: African status
      const chipTwo = document.getElementById('chipTwo');
      const chipTwoVal = document.getElementById('chipTwoVal');
      const chipTwoLabel = document.getElementById('chipTwoLabel');
      const chipTwoSub = document.getElementById('chipTwoSub');
      if (country.isAfricanContinent) {
        if (chipTwo) chipTwo.className = 'status-chip chip-card-red';
        if (chipTwoVal) chipTwoVal.textContent = country.isAfricanUnionMember ? 'AU' : 'AFR';
        if (chipTwoLabel) chipTwoLabel.textContent = country.isAfricanUnionMember ? 'African Union' : 'African Continent';
        if (chipTwoSub) chipTwoSub.textContent = country.isAfricanUnionMember ? 'Official Member State' : 'Geographic Territory';
      } else {
        if (chipTwo) chipTwo.className = 'status-chip chip-card-blue';
        const continentInitials = (country.continent || 'GLB').slice(0, 4).toUpperCase();
        if (chipTwoVal) chipTwoVal.textContent = continentInitials;
        if (chipTwoLabel) chipTwoLabel.textContent = country.continent || 'Continent';
        if (chipTwoSub) chipTwoSub.textContent = 'Non-African Region';
      }
 
      // Check OFAC categorization
      const matchesCountryList = list => list.some(entry =>
        entry.iso3 === country.iso3 || normalize(entry.name) === normalize(country.name) ||
        (entry.aliases || []).some(alias => normalize(alias) === normalize(country.name) || (country.aliases || []).some(a => normalize(a) === normalize(alias)))
      );
      const isSpecialRegion = country.type === 'region';
      const inOfac1 = isSpecialRegion || matchesCountryList(OFAC_1_SANCTION_COUNTRIES);
      const inOfac2 = !isSpecialRegion && matchesCountryList(OFAC_2_SANCTION_COUNTRIES);
 
      // Chip 3: OFAC 1 status
      const chipThree = document.getElementById('chipThree');
      const chipThreeVal = document.getElementById('chipThreeVal');
      const chipThreeLabel = document.getElementById('chipThreeLabel');
      const chipThreeSub = document.getElementById('chipThreeSub');
      if (inOfac1) {
        if (chipThree) chipThree.className = 'status-chip chip-card-red';
        if (chipThreeVal) chipThreeVal.textContent = 'CAT 1';
        if (chipThreeLabel) chipThreeLabel.textContent = 'OFAC Category 1';
        if (chipThreeSub) chipThreeSub.textContent = 'Comprehensive Embargo';
      } else {
        if (chipThree) chipThree.className = 'status-chip chip-card-green';
        if (chipThreeVal) chipThreeVal.textContent = 'PASS';
        if (chipThreeLabel) chipThreeLabel.textContent = 'OFAC Category 1';
        if (chipThreeSub) chipThreeSub.textContent = 'No Embargo Restriction';
      }
 
      // Chip 4: OFAC 2 or Primary Currency
      const chipFour = document.getElementById('chipFour');
      const chipFourVal = document.getElementById('chipFourVal');
      const chipFourLabel = document.getElementById('chipFourLabel');
      const chipFourSub = document.getElementById('chipFourSub');
      if (inOfac2) {
        if (chipFour) chipFour.className = 'status-chip chip-card-orange';
        if (chipFourVal) chipFourVal.textContent = 'CAT 2';
        if (chipFourLabel) chipFourLabel.textContent = 'OFAC Category 2';
        if (chipFourSub) chipFourSub.textContent = 'Targeted Program Active';
      } else {
        if (chipFour) chipFour.className = 'status-chip chip-card-blue';
        if (chipFourVal) chipFourVal.textContent = (country.currencies && country.currencies[0]) || (country.type === 'region' ? 'N/A' : 'STD');
        if (chipFourLabel) chipFourLabel.textContent = 'Primary Currency';
        if (chipFourSub) chipFourSub.textContent = (country.currencies && country.currencies.join(', ')) || 'ISO 4217 Standard';
      }
    }
 
    function updateLiveStatus(country) {
      selectedCountryRecord = country;
      if (country) {
        renderCountryInspection(country);
      } else {
        renderGlobalOverview();
      }
    }
 
    function resetToStandby() {
      selectedCountryRecord = null;
      document.body.classList.remove('has-country-result');
      if (result) result.classList.remove('visible');
      setText('countryName', '—');
      setText('isoChip', 'ISO 3166-1');
      setText('countryCode', '—');
      setText('currencyCode', '—');
      setText('currencyName', '');
      setText('continent', '—');
      setText('continentSub', '');
      const continentCard = document.getElementById('continentCard');
      if (continentCard) continentCard.classList.remove('continent-africa');
      const ofacCard = document.getElementById('ofacCard');
      if (ofacCard) ofacCard.classList.remove('ofac-listed');
      setText('ofacCategory', '—');
      const ofacSubEl = document.getElementById('ofacSub');
      if (ofacSubEl) {
        ofacSubEl.textContent = '';
        ofacSubEl.style.display = 'none';
      }
      renderGlobalOverview();
    }
 
    const liveStatusToggleBtn = document.getElementById('liveStatusToggleBtn');
    if (liveStatusToggleBtn) {
      liveStatusToggleBtn.addEventListener('click', () => {
        if (liveStatusDisplayMode === 'global') {
          if (selectedCountryRecord) {
            renderCountryInspection(selectedCountryRecord);
          } else {
            input.focus();
          }
        } else {
          renderGlobalOverview();
        }
      });
    }
 
    const liveStatusRefresh = document.getElementById('liveStatusRefresh');
    if (liveStatusRefresh) {
      liveStatusRefresh.addEventListener('click', () => {
        input.value = '';
        suggestions.classList.remove('open');
        suggestions.replaceChildren();
        input.setAttribute('aria-expanded', 'false');
        empty.style.display = 'none';
        resetToStandby();
        input.focus();
      });
    }
 
    // Enhance selectCountry
    const originalSelectCountry = selectCountry;
    selectCountry = function(country) {
      originalSelectCountry(country);
      updateLiveStatus(country);
    };
 
    // Clean initial load: empty search bar, standby overview
    input.value = '';
    resetToStandby();
 
    // --- Theme Controller (Light / Dark Mode) ---
    function initTheme() {
      const savedTheme = localStorage.getItem('countryscope_theme');
      let activeTheme = 'light';
      if (savedTheme === 'light' || savedTheme === 'dark') {
        activeTheme = savedTheme;
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
        activeTheme = 'light';
      }
      applyTheme(activeTheme, false);
    }
 
    function applyTheme(theme, save) {
      document.documentElement.setAttribute('data-theme', theme);
      if (save) {
        try { localStorage.setItem('countryscope_theme', theme); } catch(e) {}
      }
      const themeButton = document.getElementById('themeToggleBtn');
      if (themeButton) {
        const actionLabel = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
        themeButton.setAttribute('aria-label', actionLabel);
        themeButton.setAttribute('title', actionLabel);
      }
      const meta = document.querySelector('meta[name="color-scheme"]');
      if (meta) {
        meta.content = theme === 'dark' ? 'dark light' : 'light dark';
      }
    }
 
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        applyTheme(currentTheme === 'dark' ? 'light' : 'dark', true);
      });
    }
 
    if (window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
        if (!localStorage.getItem('countryscope_theme')) {
          applyTheme(e.matches ? 'dark' : 'light', false);
        }
      });
    }

    // Interactive card clicks
    const c1 = document.getElementById('chipOne');
    if (c1) c1.addEventListener('click', () => { input.focus(); input.select(); });
    const c2 = document.getElementById('chipTwo');
    if (c2) c2.addEventListener('click', () => { input.value = 'Africa'; renderSuggestions(); input.focus(); });
    const c3 = document.getElementById('chipThree');
    if (c3) c3.addEventListener('click', () => { input.value = 'Cuba'; renderSuggestions(); input.focus(); });
    const c4 = document.getElementById('chipFour');
    if (c4) c4.addEventListener('click', () => { input.value = 'Syria'; renderSuggestions(); input.focus(); });
 
    initTheme();
 
  </script>
  <noscript>
    <div style="margin:16px;padding:12px;border:1px solid #ff3b56;border-radius:10px;background:#1a0f12;color:#ff6b81">
      JavaScript must be enabled to use country search and OFAC category matching.
    </div>
  </noscript>
</body>
</html>
