---
import { Font, getImage } from 'astro:assets';
import CommandPalette from '@/components/layout/CommandPalette.astro';
import portrait from '@/assets/images/profile.webp';
import { profile, socialProfiles } from '@/data/profile';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const siteTitle = `${profile.name} | ${profile.title}`;
const siteDescription =
  'Front-end developer building accessible, performant React interfaces and responsive websites. Explore projects, experience, and ways to contact Asif Imran Khan.';

const { title = siteTitle, description = siteDescription, noindex = false } = Astro.props;

const siteUrl = Astro.site;
const canonicalUrl = siteUrl && !noindex ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const socialImage = await getImage({ src: portrait, format: 'jpg', width: portrait.width });
const socialImageUrl = siteUrl ? new URL(socialImage.src, siteUrl).href : undefined;

const structuredData =
  siteUrl && !noindex
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': `${siteUrl.href}#person`,
            name: profile.name,
            jobTitle: profile.title,
            url: siteUrl.href,
            image: socialImageUrl,
            email: `mailto:${profile.email}`,
            address: {
              '@type': 'PostalAddress',
              addressLocality: profile.location.city,
              addressCountry: profile.location.countryCode,
            },
            sameAs: socialProfiles.map((social) => social.url),
            knowsAbout: ['Front-end development', 'Web accessibility', ...profile.stack],
          },
          {
            '@type': 'WebSite',
            '@id': `${siteUrl.href}#website`,
            url: siteUrl.href,
            name: siteTitle,
            description: siteDescription,
            inLanguage: 'en-IN',
            publisher: { '@id': `${siteUrl.href}#person` },
          },
        ],
      }
    : undefined;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#eceae3" />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:alt" content={`Portrait of ${profile.name}`} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="twitter:creator" content="@asifikhandev" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <Font cssVariable="--font-geist" preload />
  </head>
  <body>
    <CommandPalette />
    <slot />

    <script>
      import { initRevealObserver } from '@/lib/reveal';

      initRevealObserver();
    </script>
  </body>
</html>
