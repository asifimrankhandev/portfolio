---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { profile } from '@/data/profile';
import { experienceData } from '@/data/experience';

const title = `Resume | ${profile.name}`;
const description = `Professional experience and skills for ${profile.name}, ${profile.title}.`;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" tabindex="-1" class="container-page min-h-[60vh] pb-20 focus-visible:outline-none md:pb-28">
    <header class="border-b border-ink py-16 md:py-24">
      <p class="type-label flex items-center gap-3 text-ink-soft">
        <span aria-hidden="true" class="h-px w-4 bg-ink"></span>
        Resume
      </p>
      <div class="mt-8 flex flex-wrap items-end justify-between gap-8">
        <div>
          <h1 class="type-h2">{profile.name}</h1>
          <p class="type-lead mt-4 text-ink-soft">{profile.title} · {profile.location.city}, {profile.location.country}</p>
        </div>
        <a href={`mailto:${profile.email}`} class="btn btn-accent group">
          Get in touch <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="type-lead mt-8 max-w-2xl text-ink-soft">
        Front-end developer building accessible, performant React interfaces and responsive websites.
      </p>
      <div class="mt-8 flex flex-wrap gap-3" aria-label="Download resume files">
        <a href="/resumes/Resume1.docx" download class="btn btn-secondary">
          Download Resume <span aria-hidden="true">↓</span>
        </a>
      </div>
    </header>

    <section aria-labelledby="resume-experience" class="py-14 md:py-20">
      <div class="grid gap-8 md:grid-cols-12 md:gap-6">
        <h2 id="resume-experience" class="type-label text-ink-muted md:col-span-3">Experience</h2>
        <ol class="md:col-span-9">
          {experienceData.map((entry) => (
            <li class="border-b border-line py-6 first:pt-0">
              <div class="flex flex-wrap justify-between gap-x-6 gap-y-1">
                <h3 class="type-h3">{entry.role}{entry.company && <span class="text-ink-soft"> · {entry.company}</span>}</h3>
                <p class="type-small text-ink-muted">{entry.date}</p>
              </div>
              <p class="type-small mt-2 text-ink-muted">{entry.location}</p>
              <ul class="type-small mt-4 space-y-2 text-ink-soft">
                {entry.achievements.map((achievement) => <li class="flex gap-3"><span aria-hidden="true">—</span>{achievement}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-labelledby="resume-skills" class="border-t border-ink py-14 md:py-20">
      <div class="grid gap-8 md:grid-cols-12 md:gap-6">
        <h2 id="resume-skills" class="type-label text-ink-muted md:col-span-3">Skills</h2>
        <ul class="flex flex-wrap gap-2 md:col-span-9">
          {profile.stack.map((skill) => <li class="tag">{skill}</li>)}
        </ul>
      </div>
    </section>

    <div class="border-t border-line pt-8">
      <p class="type-small text-ink-muted">Contact</p>
      <a href={`mailto:${profile.email}`} class="type-lead mt-2 inline-block underline decoration-line-strong underline-offset-4 hover:decoration-ink">{profile.email}</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
