---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';

const technicalSkills = ['React / Next.js', 'JavaScript / TypeScript', 'HTML / CSS / Tailwind'];
const professionalSkills = [
  'ICD-10 / CPT Coding',
  'Medical Coding Expertise',
  'Effective Communication',
  'Critical Thinking & Leadership',
  'Anatomy & Physiology',
];
const languages = [
  { name: 'Bengali', level: 'Native' },
  { name: 'English / Hindi / Urdu', level: 'Fluent' },
  { name: 'Kannada', level: 'Basic' },
];
const certifications = ['Certified Nurse', 'Advance Diploma In Medical Coding', 'Degree Certificate'];
const education = [
  { institution: 'Rajiv Gandhi University of Health Sciences', school: 'B M S Hospital Nursing School', years: '2018 — 2022', score: '65%' },
  { institution: 'West Bengal Council of HS Education', school: 'Model School', years: '2016 — 2018', score: '64%' },
  { institution: 'West Bengal Board of Secondary Education', school: 'Sitanagar High School [HS]', years: '2010 — 2015', score: '75%' },
];
const work = [
  {
    role: 'Freelancer',
    company: 'AIK Studio',
    dates: '2024 — PRESENT',
    summary:
      'Specializing in building responsive and accessible front-end experiences. Delivering high-quality digital products for clients worldwide.',
  },
  {
    role: 'Senior Executive Clinical',
    company: 'Sagility India Private Limited',
    dates: '01/2023 — PRESENT',
    points: [
      'Assign standardized codes for diagnoses and procedures.',
      'Ensure compliance with healthcare regulations.',
      'Communicate with insurers to resolve claims.',
    ],
  },
  {
    role: 'ER Nurse',
    company: 'New Janapriya Super Speciality Hospital',
    dates: '10/2022 — 01/2023',
    points: [
      'Rapid assessment and prioritization of patient conditions.',
      'Administered medications and performed critical procedures.',
      'Collaborated with teams for effective treatment plans.',
    ],
  },
];
---

<BaseLayout
  title={`Resume | ${profile.name}`}
  description="View Asif Imran Khan’s front-end development skills, professional experience, education, and resume."
>
  <div class="container-page max-w-5xl py-8 sm:py-12">
    <header class="mb-8 flex flex-wrap items-center justify-between gap-4 print:hidden">
      <a href="/" class="text-link text-sm"><span aria-hidden="true">←</span> Back to portfolio</a>
      <button type="button" data-print class="btn btn-primary">Download PDF</button>
    </header>

    <main id="main-content" class="border border-line-strong bg-surface p-6 sm:p-12 print:border-0 print:p-0">
      <header class="border-b border-line pb-8">
        <h1 class="type-h2">{profile.name}</h1>
        <p class="type-lead mt-4 text-ink-muted">
          {profile.email} · {profile.location.city}, Karnataka, {profile.location.country}
        </p>
      </header>

      <div class="grid gap-12 pt-10 md:grid-cols-12">
        <aside class="space-y-10 md:col-span-4">
          <section aria-labelledby="resume-skills">
            <h2 id="resume-skills" class="type-label text-ink-muted">Skills</h2>
            <p class="mt-4 text-xs font-medium text-ink-muted">Technical</p>
            <ul class="mt-2 space-y-1.5 text-sm">{technicalSkills.map((skill) => <li>{skill}</li>)}</ul>
            <p class="mt-5 text-xs font-medium text-ink-muted">Professional</p>
            <ul class="mt-2 space-y-1.5 text-sm">{professionalSkills.map((skill) => <li>{skill}</li>)}</ul>
          </section>

          <section aria-labelledby="resume-languages">
            <h2 id="resume-languages" class="type-label text-ink-muted">Languages</h2>
            <ul class="mt-4 space-y-2 text-sm">
              {languages.map((language) => (
                <li class="flex justify-between gap-4">
                  <span>{language.name}</span>
                  <span class="text-ink-muted">{language.level}</span>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="resume-certifications">
            <h2 id="resume-certifications" class="type-label text-ink-muted">Certifications</h2>
            <ul class="mt-4 space-y-1.5 text-sm">{certifications.map((item) => <li>{item}</li>)}</ul>
          </section>

          <section aria-labelledby="resume-education">
            <h2 id="resume-education" class="type-label text-ink-muted">Education</h2>
            <ul class="mt-4 space-y-6">
              {education.map((entry) => (
                <li class="text-sm">
                  <p class="font-medium">{entry.institution}</p>
                  <p class="text-ink-muted">{entry.school}</p>
                  <p class="type-small mt-1 flex justify-between text-ink-muted">
                    <span>{entry.years}</span>
                    <span>{entry.score}</span>
                  </p>
                </li>
              ))}
            </ul>
          </section>
        </aside>

        <section aria-labelledby="resume-work" class="md:col-span-8">
          <h2 id="resume-work" class="type-label text-ink-muted">Work Experience</h2>
          <ol class="mt-4">
            {work.map((job) => (
              <li class="border-b border-line py-6 first:pt-2 last:border-b-0">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="type-h3">{job.role}</h3>
                  <span class="type-small text-ink-muted">{job.dates}</span>
                </div>
                <p class="mt-1 text-sm text-ink-muted">{job.company}</p>
                {job.summary && <p class="type-body mt-4 text-ink-soft">{job.summary}</p>}
                {job.points && (
                  <ul class="type-body mt-4 space-y-1.5 text-ink-soft">
                    {job.points.map((point) => <li>・ {point}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  @media print {
    @page {
      margin: 16mm;
    }

    body {
      background: #fff;
    }
  }
</style>
