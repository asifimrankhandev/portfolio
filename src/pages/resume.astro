---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resume | Asif Imran Khan"
  description="View Asif Imran Khan’s front-end development skills, professional experience, education, and resume."
>
  <div class="antialiased py-6 px-4 sm:py-10 sm:px-6 min-h-screen bg-[#050505] text-slate-300">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center mb-10 sm:mb-12 print:hidden">
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/"
            class="text-emerald-400 hover:text-emerald-300 transition-colors flex items-center gap-2 font-medium"
          >
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Back to Portfolio
          </a>
        </div>
        <button
          type="button"
          onclick="window.print()"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-500 text-white px-6 py-2 rounded-lg font-bold hover:bg-emerald-400 transition-colors shadow-sm"
        >
          <i class="fa-solid fa-print" aria-hidden="true"></i>
          Download PDF
        </button>
      </div>

      {/* The Resume Sheet */}
      <div class="p-8 sm:p-12 md:p-16 rounded-xl bg-[#101010] shadow-lg print:shadow-none print:p-0 print:bg-white text-slate-300">

        <header class="mb-12 md:mb-16 print:mb-12 text-center md:text-left">
          <h1 class="text-4xl md:text-5xl font-bold mb-3 text-white tracking-tight">Asif Imran Khan</h1>
          <p class="text-lg md:text-xl text-slate-400">imran@idexa.app &bull; Bangalore, Karnataka, India</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">

          {/* Left Sidebar */}
          <div class="md:col-span-4 space-y-12">

            <section>
              <h3 class="text-sm font-bold uppercase tracking-widest mb-6 pb-2 border-b-2 border-slate-800 text-slate-300">Skills</h3>

              <div class="mb-6">
                <p class="text-xs uppercase mb-3 text-slate-500 font-medium tracking-wide">Technical</p>
                <ul class="space-y-2.5 text-sm text-slate-400">
                  <li>React / Next.js</li>
                  <li>JavaScript / TypeScript</li>
                  <li>HTML / CSS / Tailwind</li>
                </ul>
              </div>

              <div>
                <p class="text-xs uppercase mb-3 text-slate-500 font-medium tracking-wide">Professional</p>
                <ul class="space-y-2.5 text-sm text-slate-400">
                  <li>ICD-10 / CPT Coding</li>
                  <li>Medical Coding Expertise</li>
                  <li>Effective Communication</li>
                  <li>Critical Thinking & Leadership</li>
                  <li>Anatomy & Physiology</li>
                </ul>
              </div>
            </section>

            <section>
              <h3 class="text-sm font-bold uppercase tracking-widest mb-6 pb-2 border-b-2 border-slate-800 text-slate-300">Languages</h3>
              <ul class="space-y-3.5 text-sm text-slate-400">
                <li class="flex justify-between items-center">
                  <span>Bengali</span>
                  <span class="text-emerald-400 font-medium">Native</span>
                </li>
                <li class="flex justify-between items-center">
                  <span>English / Hindi / Urdu</span>
                  <span class="text-emerald-400 font-medium">Fluent</span>
                </li>
                <li class="flex justify-between items-center">
                  <span>Kannada</span>
                  <span class="text-emerald-400 font-medium">Basic</span>
                </li>
              </ul>
            </section>

            <section>
              <h3 class="text-sm font-bold uppercase tracking-widest mb-6 pb-2 border-b-2 border-slate-800 text-slate-300">Certifications</h3>
              <ul class="space-y-3 text-sm text-slate-400">
                <li>Certified Nurse</li>
                <li>Advance Diploma In Medical Coding</li>
                <li>Degree Certificate</li>
              </ul>
            </section>

            <section>
              <h3 class="text-sm font-bold uppercase tracking-widest mb-6 pb-2 border-b-2 border-slate-800 text-slate-300">Education</h3>

              <div class="mb-7">
                <p class="font-semibold text-sm text-white leading-snug mb-1">Rajiv Gandhi University of Health Sciences</p>
                <p class="text-sm text-slate-400">B M S Hospital Nursing School</p>
                <div class="flex justify-between text-sm mt-1 text-emerald-400 font-mono">
                  <span>2018 — 2022</span>
                  <span>65%</span>
                </div>
              </div>

              <div class="mb-7">
                <p class="font-semibold text-sm text-white leading-snug mb-1">West Bengal Council of HS Education</p>
                <p class="text-sm text-slate-400">Model School</p>
                <div class="flex justify-between text-sm mt-1 text-emerald-400 font-mono">
                  <span>2016 — 2018</span>
                  <span>64%</span>
                </div>
              </div>

              <div>
                <p class="font-semibold text-sm text-white leading-snug mb-1">West Bengal Board of Secondary Education</p>
                <p class="text-sm text-slate-400">Sitanagar High School [HS]</p>
                <div class="flex justify-between text-sm mt-1 text-emerald-400 font-mono">
                  <span>2010 — 2015</span>
                  <span>75%</span>
                </div>
              </div>
            </section>

          </div>

          {/* Right Main Content */}
          <div class="md:col-span-8">
            <section>
              <h3 class="text-sm font-bold uppercase tracking-widest mb-8 pb-2 border-b-2 border-slate-800 text-slate-300">Work Experience</h3>

              <div class="mb-12">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 gap-3">
                  <h4 class="text-2xl font-bold text-white">Freelancer</h4>
                  <span class="text-sm font-mono px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-md">2024 — PRESENT</span>
                </div>
                <p class="text-lg text-slate-400 mb-4">AIK Studio</p>
                <p class="text-base text-slate-400 leading-relaxed">
                  Specializing in building responsive and accessible front-end experiences. Delivering high-quality digital products for clients worldwide.
                </p>
              </div>

              <div class="mb-12">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 gap-3">
                  <h4 class="text-2xl font-bold text-white">Senior Executive Clinical</h4>
                  <span class="text-sm font-mono px-3 py-1 bg-slate-800 text-slate-400 rounded-md">01/2023 — PRESENT</span>
                </div>
                <p class="text-lg text-slate-400 mb-4 uppercase tracking-wide">Sagility India Private Limited</p>
                <ul class="text-base space-y-2.5 text-slate-400 leading-relaxed list-disc list-inside">
                  <li>Assign standardized codes for diagnoses and procedures.</li>
                  <li>Ensure compliance with healthcare regulations.</li>
                  <li>Communicate with insurers to resolve claims.</li>
                </ul>
              </div>

              <div>
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 gap-3">
                  <h4 class="text-2xl font-bold text-white">ER Nurse</h4>
                  <span class="text-sm font-mono px-3 py-1 bg-slate-800 text-slate-400 rounded-md">10/2022 — 01/2023</span>
                </div>
                <p class="text-lg text-slate-400 mb-4 uppercase tracking-wide">New Janapriya Super Speciality Hospital</p>
                <ul class="text-base space-y-2.5 text-slate-400 leading-relaxed list-disc list-inside">
                  <li>Rapid assessment and prioritization of patient conditions.</li>
                  <li>Administered medications and performed critical procedures.</li>
                  <li>Collaborated with teams for effective treatment plans.</li>
                </ul>
              </div>
            </section>
          </div>

        </div>
      </div>
    </div>
  </div>
</BaseLayout>
