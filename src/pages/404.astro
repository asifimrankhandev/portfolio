---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Asif Imran Khan"
  description="The page you requested could not be found. Return to Asif Imran Khan’s front-end developer portfolio."
  noindex
>
  <div class="min-h-screen flex flex-col items-center justify-center bg-canvas text-center px-6">
    <p class="ds-eyebrow mb-6">404</p>
    <h1 class="font-black uppercase leading-none tracking-tight text-ink text-[2.5rem] md:text-[4rem] mb-6">
      Page not found
    </h1>
    <p class="ds-copy text-lg max-w-md mb-10">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="pill pill-solid">Back Home</a>
      <a href="/#projects" class="pill pill-outline">View Projects</a>
    </div>
  </div>
</BaseLayout>
