---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
---

<BaseLayout
  title="Page Not Found | Asif Imran Khan"
  description="The page you requested could not be found. Return to Asif Imran Khan’s front-end developer portfolio."
  noindex
>
  <Header />
  <main id="main-content" tabindex="-1" class="container-page flex min-h-[70vh] flex-col justify-center py-24 focus-visible:outline-none">
    <p class="type-label text-ink-muted">404</p>
    <h1 class="type-display mt-6 max-w-[12ch]">Page not found</h1>
    <p class="type-lead mt-8 max-w-[40ch] text-ink-muted">
      The page you’re looking for doesn’t exist or may have moved.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/#work" class="btn btn-secondary">View work</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
