---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import portrait from '@/assets/images/profile.webp';
import { profile } from '@/data/profile';
---

<section id="about" aria-labelledby="about-heading" class="container-page section">
  <SectionHeading index="03" label="About" headingId="about-heading">
    <Fragment slot="title">I build interfaces where the <span class="text-accent">details hold up</span>.</Fragment>
  </SectionHeading>

  <div class="reveal mt-12 grid gap-10 md:mt-16 lg:grid-cols-12" data-reveal>
    <div class="lg:col-span-4">
      <Image
        src={portrait}
        alt={`Portrait of ${profile.name}`}
        widths={[320, 449]}
        sizes="(min-width: 1024px) 28vw, (min-width: 640px) 50vw, 100vw"
        class="aspect-[4/5] w-full max-w-sm bg-surface-muted object-cover"
      />
    </div>

    <div class="flex flex-col gap-10 lg:col-span-7 lg:col-start-6">
      <div class="type-h3 space-y-5">
        <p>I’m a front-end developer focused on accessible, high-performance interfaces with React and modern CSS.</p>
        <p class="text-ink-muted">
          Before software, I worked in healthcare — it shaped how I work today: methodically, with the person on the other
          end of the screen always in mind.
        </p>
      </div>

      <div>
        <p class="border-b border-ink pb-2 text-base font-medium">Stack</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies I work with">
          {profile.stack.map((item) => <li class="tag">{item}</li>)}
        </ul>
      </div>

      <a href={profile.resumePath} class="btn btn-secondary self-start">
        Read the full resume <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
