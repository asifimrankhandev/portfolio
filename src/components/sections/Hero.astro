---
import DotGrid from '@/components/ui/DotGrid.astro';
import { profile } from '@/data/profile';

const year = String(new Date().getFullYear()).slice(-2);
---

<section id="home" aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <DotGrid
    spacing={20}
    dotSize={3.5}
    radius={200}
    strength={50}
    ease={0.12}
    baseOpacity={0}
    colorClass="text-signal"
    class="-z-10"
  />

  <div class="container-page section pt-6">
    <div class="type-label flex items-center justify-between gap-4 text-[0.6875rem]">
      <span>Portfolio ’{year}</span>
      {profile.availability.open && (
        <span class="inline-flex items-center gap-2">
          <span class="status-dot status-dot-accent" aria-hidden="true"></span>
          {profile.availability.label}
        </span>
      )}
    </div>

    <h1 id="hero-title" class="type-display mt-20 max-w-[11em] md:mt-28">
      <span class="text-accent">Front-end development</span> for interfaces that feel obvious
    </h1>

    <div class="mt-14 flex flex-col gap-6 md:mt-16 md:flex-row md:items-start md:justify-between">
      <p class="type-small max-w-[25rem]">
        Front-end developer building accessible, high-performance websites with React, TypeScript, and modern CSS.
        {profile.availability.open && ` ${profile.availability.detail}.`}
      </p>
      <a href="#contact" class="type-label group inline-flex items-center gap-1.5 text-[0.6875rem]">
        Get in touch <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
