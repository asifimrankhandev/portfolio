---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { experienceData } from '@/data/experience';
import { profile } from '@/data/profile';
---

<section id="experience" aria-labelledby="experience-heading" class="container-page section">
  <SectionHeading index="06" label="Experience" headingId="experience-heading" />

  <ol>
    {experienceData.map((entry) => (
      <li class="reveal grid gap-4 border-b border-line py-8 md:grid-cols-12 md:gap-6" data-reveal>
        <p class="type-small pt-1.5 text-ink-muted md:col-span-2">{entry.date}</p>
        <div class="md:col-span-5">
          <h3 class="type-h3">{entry.role}</h3>
          <p class="type-small mt-2 text-ink-muted">
            {entry.company ? `${entry.company} · ${entry.location}` : entry.location}
          </p>
        </div>
        <ul class="type-small space-y-2 pt-1.5 text-ink-soft md:col-span-5">
          {entry.achievements.map((item) => (
            <li class="flex gap-3"><span aria-hidden="true">・</span>{item}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <a href={profile.resumePath} class="btn btn-secondary mt-10">
    Full resume <span aria-hidden="true">→</span>
  </a>
</section>
