---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { servicesData } from '@/data/services';

const letter = (i: number) => String.fromCharCode(65 + i);
---

<section id="services" aria-labelledby="services-heading" class="container-page section">
  <SectionHeading index="04" label="Why work with me?" headingId="services-heading">
    <Fragment slot="title">
      Good front-end holds both ends — <span class="text-accent">design fidelity</span> &amp;
      <span class="text-accent">engineering rigor</span>.
    </Fragment>
  </SectionHeading>

  <p class="type-title mt-12 max-w-[22em] md:mt-16">
    I work best where the interface carries real weight. My job is to remove the friction, so every interaction feels
    obvious.
  </p>

  <ol class="mt-16 grid border-y border-ink md:mt-20 md:grid-cols-3">
    {servicesData.map((service, i) => (
      <li
        class:list={[
          'reveal flex flex-col px-0 py-8 md:px-8 md:py-9',
          i > 0 && 'border-t border-ink md:border-l md:border-t-0',
        ]}
        data-reveal
      >
        <span class="grid size-8 place-items-center border border-line-strong text-xs text-accent-strong" aria-hidden="true">
          {letter(i)}
        </span>
        <h3 class="type-h3 mt-10 md:mt-12">{service.title}</h3>
        <p class="type-small mt-3 max-w-[22rem] text-ink-soft">{service.description}</p>
      </li>
    ))}
  </ol>
</section>
