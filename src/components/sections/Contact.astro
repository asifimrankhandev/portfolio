---
import GrainSpotlight from '@/components/ui/GrainSpotlight.astro';
import { profile } from '@/data/profile';
---

<section id="contact" aria-labelledby="contact-heading" class="container-page section">
  <div class="relative isolate overflow-hidden border border-line-strong bg-surface-muted px-6 py-20 md:px-24 md:py-28">
    <GrainSpotlight class="-z-10" />
    <p class="type-label flex items-center gap-3 text-[0.8125rem]">
      <span aria-hidden="true" class="h-px w-4 bg-ink"></span>
      Get in touch
    </p>
    <h2 id="contact-heading" class="type-title mt-6 max-w-[14em]">
      Have a <span class="text-accent">product idea</span> that needs a sharp front end?
    </h2>
    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={`mailto:${profile.email}`} class="btn btn-accent group">
        Email me <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <button
        type="button"
        data-copy-email={profile.email}
        class="type-small text-ink-soft underline decoration-line-strong underline-offset-4 hover:decoration-ink"
      >
        <span data-copy-label>Copy {profile.email}</span>
      </button>
    </div>
    <p class="type-label mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.8125rem]">
      {profile.availability.open && <span>{profile.availability.detail}</span>}
      {profile.availability.open && <span aria-hidden="true" class="size-1.5 bg-accent"></span>}
      <span>Based in {profile.location.city}, {profile.location.country}</span>
    </p>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyLabel = copyButton?.querySelector<HTMLElement>('[data-copy-label]');

  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail;
    if (!copyLabel || !email) return;
    const original = copyLabel.textContent;
    try {
      await navigator.clipboard.writeText(email);
      copyLabel.textContent = 'Copied to clipboard';
      window.setTimeout(() => {
        copyLabel.textContent = original;
      }, 2000);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });
</script>
