---
import { experienceData, getExperienceYears } from '@/data/experience';

const years = getExperienceYears();
---

<section class="py-24 md:py-32 bg-canvas" id="experience">
  <div class="reveal container mx-auto px-6 max-w-7xl" data-reveal>

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-16">
      <div>
        <p class="ds-eyebrow mb-4">/ Experience</p>
        <h2 class="font-display font-bold leading-none tracking-tight text-gradient text-[2.5rem] md:text-[3.5rem]">
          Professional Background
        </h2>
      </div>
      <p class="text-sm font-bold uppercase tracking-widest text-ink-muted">{years}+ years of experience</p>
    </div>

    <div class="border-t border-line">
      {experienceData.map((exp) => (
        <div class="border-b border-line py-10">
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">
            <div class="lg:col-span-1">
              <p class="text-xs font-bold tracking-widest uppercase text-ink-muted mb-1">{exp.date}</p>
              <p class="text-xs font-medium uppercase tracking-widest text-ink/40">{exp.location}</p>
            </div>

            <div class="lg:col-span-3">
              <h3 class="font-display font-semibold text-2xl md:text-3xl text-ink tracking-tight mb-2">{exp.role}</h3>
              {exp.company && <p class="text-sm font-bold tracking-widest uppercase text-ink/80 mb-6">{exp.company}</p>}

              <ul class="ds-copy space-y-3 text-base">
                {exp.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
