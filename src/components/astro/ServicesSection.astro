---
import { servicesData } from '@/data/services';
---

<section class="py-24 md:py-32 bg-canvas" id="services">
  <div class="reveal container mx-auto px-6 max-w-7xl" data-reveal>
    <div class="mb-16">
      <p class="ds-eyebrow mb-4">/ Service</p>
      <h2 class="w-fit font-display font-bold leading-none tracking-tight text-gradient-cyan text-[2.5rem] md:text-[3.5rem]">
        What I do
      </h2>
    </div>

    <div class="border-t border-line">
      {servicesData.map((service) => (
        <div class="border-b border-line py-10 flex flex-col md:flex-row md:items-baseline gap-4 md:gap-16">
          <h3 class="font-display font-semibold tracking-tight text-2xl md:text-3xl text-ink md:w-1/3 shrink-0">
            {service.title}
          </h3>
          <p class="ds-copy text-base md:text-lg md:w-2/3">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
