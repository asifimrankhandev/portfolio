<div data-cursor-glow class="pointer-events-none fixed left-0 top-0 z-[9998] opacity-0 mix-blend-overlay transition-opacity duration-500" aria-hidden="true">
  <div class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full" style="width:800px;height:800px;background:radial-gradient(circle,rgba(255,255,255,.8) 0%,transparent 50%)"></div>
</div>
<div data-custom-cursor class="pointer-events-none fixed left-0 top-0 z-[10000] opacity-0 mix-blend-difference transition-opacity" aria-hidden="true">
  <div data-cursor-dot class="absolute size-4 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white opacity-100 transition-all duration-300 ease-out"></div>
</div>

<script>
  const glow = document.querySelector<HTMLElement>('[data-cursor-glow]');
  const cursor = document.querySelector<HTMLElement>('[data-custom-cursor]');
  const dot = document.querySelector<HTMLElement>('[data-cursor-dot]');
  const finePointer = window.matchMedia('(pointer: fine)');
  let frame = 0;
  let latestPointer: PointerEvent | undefined;

  const disableCursor = () => {
    glow?.classList.add('opacity-0');
    cursor?.classList.add('opacity-0');
  };
  const onPointerMove = (event: PointerEvent) => {
    latestPointer = event;
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      if (!latestPointer) return;
      const { clientX: x, clientY: y, target } = latestPointer;
      const transform = `translate3d(${x}px, ${y}px, 0)`;
      if (glow) glow.style.transform = transform;
      if (cursor) cursor.style.transform = transform;
      const hovering = target instanceof Element && Boolean(target.closest('a,button,input,textarea,[role="button"]'));
      dot?.classList.toggle('size-12', hovering);
      dot?.classList.toggle('opacity-50', hovering);
      dot?.classList.toggle('size-4', !hovering);
      dot?.classList.toggle('opacity-100', !hovering);
      glow?.classList.remove('opacity-0');
      cursor?.classList.remove('opacity-0');
    });
  };
  const onPointerLeave = () => disableCursor();

  const syncPointerMode = () => {
    if (finePointer.matches) {
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      document.documentElement.classList.add('has-custom-cursor');
    } else {
      window.removeEventListener('pointermove', onPointerMove);
      document.documentElement.classList.remove('has-custom-cursor');
      disableCursor();
    }
  };

  finePointer.addEventListener('change', syncPointerMode);
  document.addEventListener('pointerleave', onPointerLeave);
  document.addEventListener('pointerenter', onPointerMove);
  syncPointerMode();
</script>
