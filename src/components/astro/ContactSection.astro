---
import { Contact } from '@/components/react/Contact';
---

<section class="py-24 md:py-32 bg-canvas" id="contact">
  <div class="container mx-auto px-6 max-w-4xl">

    <div class="reveal text-center mb-16" data-reveal>
      <p class="ds-eyebrow mb-4 justify-center flex">/ Contact</p>
      <h2 class="font-display font-bold leading-none tracking-tight text-gradient text-[2.25rem] sm:text-[3rem] md:text-[3.75rem] mb-6">
        Have a project in mind?
      </h2>
      <p class="ds-copy text-lg max-w-xl mx-auto">
        I am currently open to new opportunities. Fill out the form below or send me a direct email.
      </p>
    </div>

    <div class="reveal" data-reveal>
      <Contact client:visible />
    </div>
  </div>
</section>
