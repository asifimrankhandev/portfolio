---
import { profile, socialProfiles } from '@/data/profile';

const sections = [
  { id: 'home', label: 'Home' },
  { id: 'work', label: 'Work' },
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---

<dialog
  data-command-dialog
  aria-label="Command menu"
  class="command-dialog w-[calc(100%-2rem)] max-w-xl overflow-hidden border border-ink bg-surface p-0 text-ink shadow-[0_1.5rem_4rem_rgb(14_14_15/0.14)] backdrop:bg-ink/30"
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <svg class="size-4 shrink-0 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
    </svg>
    <input
      data-command-search
      type="search"
      aria-label="Search commands"
      placeholder="Jump to…"
      class="min-w-0 flex-1 bg-transparent py-4 text-base outline-none placeholder:text-ink-muted"
    />
    <kbd class="type-label hidden border border-line px-1.5 py-0.5 text-ink-muted sm:inline">esc</kbd>
  </div>

  <div class="max-h-80 overflow-y-auto p-2">
    <div data-command-group role="group" aria-labelledby="command-group-sections" class="mb-2">
      <p id="command-group-sections" class="type-label px-2 py-1.5 text-ink-muted">Sections</p>
      {sections.map((section) => (
        <button type="button" data-command-item data-section={section.id} data-label={section.label} class="command-item">
          {section.label}
        </button>
      ))}
      <a data-command-item data-label="Resume" href={profile.resumePath} class="command-item">Resume</a>
    </div>

    <div data-command-group role="group" aria-labelledby="command-group-links">
      <p id="command-group-links" class="type-label px-2 py-1.5 text-ink-muted">Elsewhere</p>
      <a data-command-item data-label={`Email ${profile.email}`} href={`mailto:${profile.email}`} class="command-item">
        Email
        <span class="ml-auto text-ink-muted">{profile.email}</span>
      </a>
      {socialProfiles.map((social) => (
        <a data-command-item data-label={social.label} href={social.url} target="_blank" rel="noopener noreferrer" class="command-item">
          {social.label}
          <span class="ml-auto text-ink-muted" aria-hidden="true">↗</span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      ))}
    </div>

    <p data-command-empty hidden class="py-6 text-center text-sm text-ink-muted">No results.</p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-command-dialog]');
  const search = dialog?.querySelector<HTMLInputElement>('[data-command-search]');
  const items = [...(dialog?.querySelectorAll<HTMLElement>('[data-command-item]') ?? [])];
  const empty = dialog?.querySelector<HTMLElement>('[data-command-empty]');
  let lastFocused: HTMLElement | null = null;

  const open = () => {
    if (!dialog || dialog.open) return;
    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    dialog.showModal();
    search?.focus();
  };

  const close = () => {
    if (!dialog?.open) return;
    dialog.close();
  };

  const filter = (query: string) => {
    const normalized = query.trim().toLowerCase();
    let visibleCount = 0;
    items.forEach((item) => {
      const visible = (item.dataset.label ?? '').toLowerCase().includes(normalized);
      item.hidden = !visible;
      if (visible) visibleCount += 1;
    });
    dialog?.querySelectorAll<HTMLElement>('[data-command-group]').forEach((group) => {
      group.hidden = !group.querySelector('[data-command-item]:not([hidden])');
    });
    if (empty) empty.hidden = visibleCount > 0;
  };

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) close();
      else open();
    }
  });

  document.querySelectorAll('[data-command-open]').forEach((trigger) => trigger.addEventListener('click', open));

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });

  dialog?.addEventListener('close', () => {
    if (search) search.value = '';
    filter('');
    lastFocused?.focus();
  });

  search?.addEventListener('input', () => filter(search.value));

  dialog?.querySelectorAll<HTMLButtonElement>('button[data-section]').forEach((button) =>
    button.addEventListener('click', () => {
      const section = button.dataset.section;
      close();
      if (!section) return;
      if (window.location.pathname !== '/') {
        window.location.assign(section === 'home' ? '/' : `/#${section}`);
        return;
      }
      if (section === 'home') window.scrollTo({ top: 0, behavior: 'smooth' });
      else document.getElementById(section)?.scrollIntoView({ behavior: 'smooth' });
    }),
  );

  dialog?.querySelectorAll('a[data-command-item]').forEach((link) => link.addEventListener('click', close));
</script>

<style>
  .command-dialog[open] {
    position: fixed;
    top: 18vh;
    left: 50%;
    margin: 0;
    transform: translateX(-50%);
  }

  .command-item {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    text-align: left;
  }

  .command-item[hidden] {
    display: none;
  }

  .command-item:hover,
  .command-item:focus-visible {
    background: var(--color-surface-muted);
    outline: none;
  }
</style>
