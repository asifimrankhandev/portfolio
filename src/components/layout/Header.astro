---
import { profile } from '@/data/profile';

const isHome = Astro.url.pathname === '/';
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);

const links = [
  { label: 'Home', href: isHome ? '#home' : '/', section: 'home' },
  { label: 'Work', href: sectionHref('work'), section: 'work' },
  { label: 'About', href: sectionHref('about'), section: 'about' },
];
---

<header class="sticky top-0 z-[1000] bg-canvas">
  <a
    href="#main-content"
    class="btn btn-primary fixed left-4 top-3 z-[1200] -translate-y-24 focus-visible:translate-y-0"
  >
    Skip to content
  </a>
  <div class="container-page">
    <div class="grid h-[var(--header-height)] grid-cols-[1fr_auto] items-center border-b border-ink md:grid-cols-3">
      <a href={isHome ? '#home' : '/'} class="type-label justify-self-start text-[0.8125rem]">{profile.name}</a>

      <nav class="hidden items-center gap-6 justify-self-center md:flex" aria-label="Primary navigation">
        {links.map((link) => (
          <a
            href={link.href}
            data-nav-section={link.section}
            class="type-label text-[0.8125rem] underline-offset-[5px] hover:underline aria-[current=location]:underline aria-[current=location]:decoration-accent"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4 justify-self-end">
        <button
          type="button"
          data-command-open
          class="type-label hidden border border-line px-1.5 py-0.5 text-[0.6875rem] text-ink-muted transition-colors hover:border-ink hover:text-ink sm:inline-block"
          aria-label="Open command menu"
          aria-keyshortcuts="Meta+K Control+K"
        >
          ⌘K
        </button>
        <a href={`mailto:${profile.email}`} class="type-label group hidden text-[0.8125rem] sm:inline-flex sm:items-center sm:gap-1.5">
          Email me <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <button
          type="button"
          data-menu-toggle
          class="type-label -mr-2 px-2 py-2 text-[0.8125rem] md:hidden"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <span data-menu-label>Menu</span>
        </button>
      </div>
    </div>
  </div>
</header>

<div
  id="mobile-navigation"
  data-mobile-navigation
  class="fixed inset-x-0 bottom-0 top-[var(--header-height)] z-[900] hidden flex-col justify-between bg-canvas md:hidden"
>
  <nav class="container-page flex flex-col pt-4" aria-label="Mobile navigation">
    {links.map((link) => (
      <a href={link.href} data-nav-section={link.section} class="type-h2 border-b border-line py-4">
        {link.label}
      </a>
    ))}
    <a href={sectionHref('contact')} class="type-h2 border-b border-line py-4">Contact</a>
  </nav>
  <p class="container-page type-label flex items-center gap-2 pb-8">
    <span class="status-dot status-dot-accent" aria-hidden="true"></span>
    {profile.availability.label}
  </p>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const toggleLabel = toggle?.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-navigation]');

  const setMenuOpen = (open: boolean, { restoreFocus = false } = {}) => {
    if (!toggle || !menu) return;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
    if (toggleLabel) toggleLabel.textContent = open ? 'Close' : 'Menu';
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (restoreFocus) toggle.focus();
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false, { restoreFocus: true });
    }
  });

  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  if (window.location.pathname === '/') {
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]')];
    const sections = document.querySelectorAll<HTMLElement>('main section[id]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => {
            if (link.dataset.navSection === entry.target.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
